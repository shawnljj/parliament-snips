# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Transient backfill state (regenerated on each run)
backfill.log
backfill_status.json

# In-flight writes from the atomic writers (tmp + os.replace). A .tmp on disk
# means a build was interrupted mid-write; it is never a real artifact.
# Now covers the year shards too (data/2026/, summaries/2026/).
*.tmp
data/**/*.tmp
summaries/**/*.tmp
site/dist/**/*.tmp

# A mis-passed CLI flag once created a literal "--out/" build directory here.
--out/

# Stage 1 dataset payloads: ~270 MB and deterministically regenerated in ~70s by
# `python3 summariser/build_dataset.py`. They are derived artifacts, not source, so
# they are not versioned -- but the INDEX and STATE are, because those are small,
# readable, and are exactly what a reviewer or the dashboard needs.
pipeline/dataset/*/
pipeline/dataset/*/*.json
!pipeline/dataset/index.json

# NOTE: site/dist/ IS tracked on purpose -- it is the built site that Vercel
# deploys. Do not add it here.

# --- Pipeline data: derived, large, and regenerable. NOT source. ---
# These were untracked but NOT ignored, which is a footgun: a `git add -A` would
# try to stage ~1.4 GB. Ignore them so a careless add cannot.
pipeline/hansard.db
pipeline/hansard.db-*
pipeline/chunks.jsonl
pipeline/turns.jsonl
# The vectors are 157 MB of float16 array plus a 6.6 MB id list, rebuilt by
# `python3 rag/embed_chunks.py`. The RECIPE is versioned; the array is not.
pipeline/vectors/
# Re-fetched paragraph structure, 184 MB across 1,036 report files (~200s to
# rebuild, resumable -- see rag/README.md). Cache, not source.
pipeline/para_cache/

# --- Agent scratch: belongs to the Hermes profile, not this repo ---
.hermes/

# OS
.DS_Store
